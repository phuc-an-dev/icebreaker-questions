# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/icebreaker_db?retryWrites=true&w=majority"

# Database Name
MONGODB_DB="icebreaker_db"

# Admin Dashboard Security
ADMIN_PASSWORD="your_secure_admin_password"
ADMIN_SESSION_SECRET="your_random_secret_string"
MASTER_ADMIN_EMAIL="admin@icebreaker.local"
MASTER_ADMIN_PASSWORD="your_master_admin_password"

# Public Site Canonical URL (Optional, defaults to https://icebreaker.website)
NEXT_PUBLIC_SITE_URL="https://icebreaker.website"
